// =====================================================================
// SECRET TEMPLATE — copy this file to `secret.h` and fill in your values.
// `secret.h` is gitignored, so real credentials are never committed.
// =====================================================================

// 0 = normal WPA/WPA2 WiFi, 1 = eduroam (WPA2-Enterprise / EAP)
#define USE_EDUROAM 0

// WiFi network (for eduroam: SSID "eduroam", WIFI_PASS = your UCL password)
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASS "YOUR_WIFI_PASSWORD"

// eduroam / UCL account (used only when USE_EDUROAM is 1)
#define WIFI_USER "XXXXXX@ucl.ac.uk"
