# Copy this file to `.env` and fill in your values.
# `.env` is gitignored, so nothing sensitive gets committed.

# HTTP port for the dashboard/API.
PORT=3001

# Set to "false" once your real ESP32 is connected so simulated demo data stops.
SIMULATE=true
SEED=true

# MQTT broker (leave empty to disable MQTT entirely).
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC=bioreactor
MQTT_DEVICE_ID=bio1

# Optional: custom SQLite location (defaults to backend/bioreactor.db).
# DB_PATH=/absolute/path/to/bioreactor.db
