  "description": "Web UI, REST API and SQLite storage for the small-scale connected bioreactor (temperature, pH and stirring control).",
  "main": "backend/server.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "backend": "node --disable-warning=ExperimentalWarning backend/server.js",
